# ─────────────────────────────────────────────────────────────────────────────
# The reader (the donated app) needs NO environment variables.
# It reads the full year from bundled static JSON and runs entirely in the
# browser — no database, no keys, no server. Everything below is OWNER-ONLY.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# OWNER-ONLY — private daily-generation/delivery pipeline.
# NONE of this is part of, or required by, the donated reader. It powers the
# original maintainer's personal daily email/chat delivery and should be removed
# when preparing the clean gift for SRF (see docs/DONATION_HANDOFF.md).
# ═════════════════════════════════════════════════════════════════════════════

# Server-side Supabase (pipeline writes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI generation (owner's private experiment — NOT used by the donated reader)
GEMINI_API_KEY=
SRF_GENERATION_MODEL=gemini-2.5-flash-image
SRF_TEXT_MODEL=gemini-2.5-flash
SRF_IMAGE_PROVIDER=gemini
SRF_IMAGE_BUCKET=daily-renders

# Private delivery targets (owner's own accounts/channels)
SRF_DRIVE_ROOT_FOLDER_ID=
SRF_EMAIL_TO=
SRF_FROM_EMAIL=
SRF_TELEGRAM_TARGET=
SRF_SLACK_TARGET=
SRF_DISCORD_TARGET=

# Serverless cron protection
CRON_SECRET=
SRF_RUN_DAILY_TOKEN=
SRF_APP_URL=
